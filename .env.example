# ==========================================================
# Meu AUmigo — configuração. Copie para .env e preencha.
# O .env NÃO é versionado.
#
# O PostgreSQL roda no HOST desta VPS (fora do Docker), então de dentro
# do container o host é sempre `host.docker.internal`. Ver docs/OPERACAO.md.
# ==========================================================

NODE_ENV=production
APP_PORT=1046
APP_URL=https://meuaumigo.com.br

# ----------------------------------------------------------
# Banco — duas conexões, dois papéis.
#   meuaumigo_app   → só DML. É quem a app usa.
#   meuaumigo_owner → dono do schema, APENAS para `prisma migrate deploy`.
# A app não pode alterar o próprio schema: é isso que separa um bug de
# uma perda de histórico de doação.
# ----------------------------------------------------------
DATABASE_URL=postgresql://meuaumigo_app:SENHA_AQUI@host.docker.internal:5432/meuaumigo?schema=public
DATABASE_URL_OWNER=postgresql://meuaumigo_owner:SENHA_AQUI@host.docker.internal:5432/meuaumigo?schema=public

# ----------------------------------------------------------
# Mídia — fotos e vídeos dos animais, comprovantes de despesa.
# Volume Docker; entra na rotina de backup junto com o banco.
# ----------------------------------------------------------
STORAGE_DIR=/app/storage

# ----------------------------------------------------------
# Sessão
# ----------------------------------------------------------
SESSAO_HORAS=12

# ----------------------------------------------------------
# Meu AUmigo AI — apoio à equipe: redigir atualização para padrinhos,
# resumir histórico médico, analisar despesas, gerar texto de campanha.
# Sem chave, a tela mostra "não configurado" e TODO o resto do sistema
# segue funcionando. A IA nunca é caminho crítico.
# ----------------------------------------------------------
ANTHROPIC_API_KEY=
MODELO_IA=claude-sonnet-5

# ----------------------------------------------------------
# Semente de demonstração. Com `true`, o boot popula o banco vazio com
# dados FICTÍCIOS (animais, padrinhos, 12 meses de financeiro) para a
# equipe conhecer o sistema antes de ter dado real.
#
# Vire para `false` no dia em que o primeiro dado verdadeiro entrar.
# A semente nunca sobrescreve banco que já tenha animal cadastrado.
# ----------------------------------------------------------
SEMEAR_DEMONSTRACAO=true

# Senha dos três acessos de demonstração. Deixe em branco para que a semente
# sorteie uma e a imprima no log do boot (`docker compose logs app`).
# Nunca versione uma senha aqui: este .env não vai para o repositório, mas o
# .env.example vai.
SENHA_DEMO=
